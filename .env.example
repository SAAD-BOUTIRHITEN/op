# Domaine public du site (utilisé pour les canonicals et les métadonnées Open Graph)
NEXT_PUBLIC_SITE_URL="https://luneaoptique.live"

# Destination du formulaire de contact : n'importe quel webhook acceptant du JSON
# (Formspree, Make, Zapier, n8n, une fonction maison). Tant qu'il est vide, le
# formulaire n'est pas affiché et la page propose WhatsApp et le téléphone.
CONTACT_WEBHOOK_URL=""

# Développement uniquement — hôtes autorisés à charger les ressources du serveur
# de dev (HMR). Nécessaire pour tester depuis un téléphone sur le même Wi-Fi.
# Votre IP locale s'affiche au lancement de `npm run dev`, ligne "Network".
DEV_ORIGINS="192.168.1.12"
